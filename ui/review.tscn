[gd_scene format=3]

[ext_resource type="Script" path="res://ui/review.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/board_view.tscn" id="2"]
[ext_resource type="Script" path="res://ui/eval_bar.gd" id="3"]
[ext_resource type="Script" path="res://ui/eval_graph.gd" id="4"]

[node name="Review" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1216, 0.1176, 0.1098, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 12

[node name="Content" type="Control" parent="Margin"]
layout_mode = 2

[node name="Card" type="Panel" parent="Margin/Content"]
layout_mode = 0
theme_type_variation = &"CardPanel"
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"ExtraBoldText"
theme_override_font_sizes/font_size = 18
text = "Game Review"

[node name="Result" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_type_variation = &"MutedText"
theme_override_font_sizes/font_size = 11
autowrap_mode = 3

[node name="Progress" type="ProgressBar" parent="Margin/Content"]
visible = false
layout_mode = 2

[node name="ProgressText" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 0
theme_override_font_sizes/font_size = 11
horizontal_alignment = 2

[node name="AnalysisError" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="ReviewBody" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = 24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="EvalBar" type="Control" parent="Margin/Content/ReviewBody"]
custom_minimum_size = Vector2(28, 0)
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("3")

[node name="Score" type="Label" parent="Margin/Content/ReviewBody/EvalBar"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 6.0
offset_bottom = 22.0
theme_type_variation = &"ExtraBoldText"
theme_override_font_sizes/font_size = 10
horizontal_alignment = 1
mouse_filter = 2

[node name="BoardView" parent="Margin/Content/ReviewBody" instance=ExtResource("2")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="TopPlayer" type="Label" parent="Margin/Content/ReviewBody/BoardView"]
layout_mode = 0
theme_type_variation = &"BoldText"
theme_override_font_sizes/font_size = 14
mouse_filter = 2

[node name="BottomPlayer" type="Label" parent="Margin/Content/ReviewBody/BoardView"]
layout_mode = 0
theme_type_variation = &"BoldText"
theme_override_font_sizes/font_size = 14
mouse_filter = 2

[node name="TopDot" type="Panel" parent="Margin/Content/ReviewBody/BoardView"]
layout_mode = 0
mouse_filter = 2

[node name="BottomDot" type="Panel" parent="Margin/Content/ReviewBody/BoardView"]
layout_mode = 0
mouse_filter = 2

[node name="Side" type="VBoxContainer" parent="Margin/Content/ReviewBody"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.6

[node name="HeaderSpace" type="Control" parent="Margin/Content/ReviewBody/Side"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2

[node name="AccuracyHelp" type="Button" parent="Margin/Content/ReviewBody/Side"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Accuracy  ?"
flat = true
alignment = 0

[node name="Summary" type="Label" parent="Margin/Content/ReviewBody/Side"]
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="ClassHelp" type="Button" parent="Margin/Content/ReviewBody/Side"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Moves  ?"
flat = true
alignment = 0

[node name="Counts" type="GridContainer" parent="Margin/Content/ReviewBody/Side"]
layout_mode = 2
columns = 4
theme_override_constants/v_separation = 0
theme_override_constants/h_separation = 8

[node name="EvalGraph" type="Control" parent="Margin/Content/ReviewBody/Side"]
custom_minimum_size = Vector2(0, 60)
layout_mode = 2
script = ExtResource("4")

[node name="ClassToggle" type="Button" parent="Margin/Content/ReviewBody/Side"]
visible = false
layout_mode = 2
text = "Move classes"

[node name="UnanalysedNotice" type="Label" parent="Margin/Content/ReviewBody/Side"]
visible = false
layout_mode = 2
theme_type_variation = &"BoldText"
text = "This game hasn’t been analysed yet"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Moves" type="Tree" parent="Margin/Content/ReviewBody/Side"]
layout_mode = 2
size_flags_vertical = 3
columns = 3
column_titles_visible = false
hide_root = true

[node name="RepertoireExit" type="Label" parent="Margin/Content/ReviewBody/Side"]
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="Navigation" type="HBoxContainer" parent="Margin/Content/ReviewBody/Side"]
layout_mode = 2
alignment = 1

[node name="First" type="Button" parent="Margin/Content/ReviewBody/Side/Navigation"]
layout_mode = 2
text = "|◀"
tooltip_text = "First move"

[node name="Previous" type="Button" parent="Margin/Content/ReviewBody/Side/Navigation"]
layout_mode = 2
text = "◀"
tooltip_text = "Previous move"

[node name="Next" type="Button" parent="Margin/Content/ReviewBody/Side/Navigation"]
layout_mode = 2
text = "▶"
tooltip_text = "Next move"

[node name="Last" type="Button" parent="Margin/Content/ReviewBody/Side/Navigation"]
layout_mode = 2
text = "▶|"
tooltip_text = "Last move"

[node name="FooterSpace" type="Control" parent="Margin/Content/ReviewBody/Side"]
custom_minimum_size = Vector2(0, 74)
layout_mode = 2

[node name="Actions" type="HFlowContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 4
theme_override_font_sizes/font_size = 10

[node name="CopyPgn" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Copy PGN"

[node name="Lichess" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Open in Lichess"

[node name="Rematch" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Rematch"
tooltip_text = "Rematch (Space)"

[node name="Setup" type="Button" parent="Margin/Content/Actions"]
layout_mode = 2
