[gd_scene format=3]

[ext_resource type="Script" path="res://ui/home.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/board_view.tscn" id="2"]
[ext_resource type="Texture2D" path="res://ui/icons/home-bullet.svg" id="3"]
[ext_resource type="Texture2D" path="res://ui/icons/home-blitz.svg" id="4"]
[ext_resource type="Texture2D" path="res://ui/icons/custom.svg" id="5"]
[ext_resource type="Texture2D" path="res://ui/icons/history.svg" id="6"]
[ext_resource type="Texture2D" path="res://ui/icons/profile.svg" id="7"]
[ext_resource type="Texture2D" path="res://ui/icons/settings.svg" id="8"]
[ext_resource type="Texture2D" path="res://ui/icons/quit.svg" id="9"]
[ext_resource type="Script" path="res://ui/icon_button.gd" id="10"]
[ext_resource type="Texture2D" path="res://ui/icons/home-course.svg" id="11"]
[ext_resource type="Texture2D" path="res://ui/icons/home-chevron.svg" id="12"]

[node name="Home" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.121569, 0.117647, 0.109804, 1)

[node name="Center" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Board" parent="Center" instance=ExtResource("2")]
layout_mode = 0
mouse_filter = 2

[node name="Form" type="Control" parent="Center"]
layout_mode = 0
mouse_filter = 2

[node name="Title" type="Label" parent="Center/Form"]
theme_type_variation = &"ExtraBoldText"
theme_override_font_sizes/font_size = 36
text = "P-Chess"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Continue" type="Button" parent="Center/Form"]
theme_type_variation = &"PrimaryButton"
theme_override_colors/font_color = Color(0, 0, 0, 0)
theme_override_colors/font_hover_color = Color(0, 0, 0, 0)
theme_override_colors/font_pressed_color = Color(0, 0, 0, 0)
theme_override_colors/font_hover_pressed_color = Color(0, 0, 0, 0)
theme_override_colors/font_focus_color = Color(0, 0, 0, 0)
text = "Start the course"
alignment = 0
clip_text = true

[node name="Eyebrow" type="Label" parent="Center/Form/Continue"]
mouse_filter = 2
theme_type_variation = &"SemiboldText"
theme_override_colors/font_color = Color(0.078, 0.078, 0.071, 1)
theme_override_font_sizes/font_size = 13

[node name="UnitTitle" type="Label" parent="Center/Form/Continue"]
mouse_filter = 2
theme_type_variation = &"ExtraBoldText"
theme_override_colors/font_color = Color(0.078, 0.078, 0.071, 1)
theme_override_font_sizes/font_size = 26
clip_text = true

[node name="Detail" type="Label" parent="Center/Form/Continue"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.078, 0.078, 0.071, 1)
theme_override_font_sizes/font_size = 16
clip_text = true

[node name="Progress" type="ProgressBar" parent="Center/Form/Continue"]
mouse_filter = 2
show_percentage = false

[node name="Chevron" type="TextureRect" parent="Center/Form/Continue"]
mouse_filter = 2
texture = ExtResource("12")
expand_mode = 1
stretch_mode = 5

[node name="Course" type="Button" parent="Center/Form"]
theme_type_variation = &"RaisedButton"
text = "Course"
theme_override_colors/font_color = Color(0, 0, 0, 0)
theme_override_colors/font_hover_color = Color(0, 0, 0, 0)
theme_override_colors/font_pressed_color = Color(0, 0, 0, 0)
theme_override_colors/font_hover_pressed_color = Color(0, 0, 0, 0)
theme_override_colors/font_focus_color = Color(0, 0, 0, 0)

[node name="Icon" type="TextureRect" parent="Center/Form/Course"]
mouse_filter = 2
