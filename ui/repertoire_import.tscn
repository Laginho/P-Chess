[gd_scene format=3]

[ext_resource type="Script" path="res://ui/repertoire_import.gd" id="1"]

[node name="RepertoireImport" type="PopupPanel"]
title = "Import repertoire"
size = Vector2i(540, 320)
exclusive = true
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
offset_right = 540.0
offset_bottom = 320.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Form" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Form"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Import your repertoire"

[node name="PathLabel" type="Label" parent="Margin/Form"]
layout_mode = 2
text = "PGN file"

[node name="FileRow" type="HBoxContainer" parent="Margin/Form"]
layout_mode = 2

[node name="Path" type="LineEdit" parent="Margin/Form/FileRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "PGN file"
tooltip_text = "PGN with chapters and variations"

[node name="Browse" type="Button" parent="Margin/Form/FileRow"]
layout_mode = 2
text = "Browse…"

[node name="NameLabel" type="Label" parent="Margin/Form"]
layout_mode = 2
text = "Repertoire name"

[node name="Name" type="LineEdit" parent="Margin/Form"]
layout_mode = 2
placeholder_text = "Repertoire name (existing name replaces its save)"
max_length = 100

[node name="ColourLabel" type="Label" parent="Margin/Form"]
layout_mode = 2
text = "Your colour"

[node name="Colour" type="OptionButton" parent="Margin/Form"]
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "White"
popup/item_0/id = 0
popup/item_1/text = "Black"
popup/item_1/id = 1

[node name="Status" type="Label" parent="Margin/Form"]
layout_mode = 2
autowrap_mode = 3

[node name="Import" type="Button" parent="Margin/Form"]
layout_mode = 2
text = "Import and save"

[node name="Done" type="Button" parent="Margin/Form"]
layout_mode = 2
text = "Cancel"

[node name="Files" type="FileDialog" parent="."]
title = "Choose repertoire PGN"
file_mode = 0
access = 2
filters = PackedStringArray("*.pgn ; PGN games")
