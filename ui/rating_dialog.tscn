[gd_scene format=3]

[ext_resource type="Script" path="res://ui/rating_dialog.gd" id="1"]

[node name="RatingDialog" type="AcceptDialog"]
borderless = true
unresizable = true
exclusive = true
dialog_hide_on_ok = false
dialog_close_on_escape = false
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Content"]
theme_type_variation = &"ExtraBoldText"
theme_override_font_sizes/font_size = 22
text = "Where are you now?"

[node name="Description" type="Label" parent="Content"]
custom_minimum_size = Vector2(480, 0)
theme_type_variation = &"MutedText"
text = "Your rating picks your stage and how strong Maia plays. You can change it in Profile."
autowrap_mode = 3

[node name="Row" type="HBoxContainer" parent="Content"]
theme_override_constants/separation = 10

[node name="Sentence" type="Label" parent="Content/Row"]
text = "I'm rated"
vertical_alignment = 1

[node name="RatingNumber" type="LineEdit" parent="Content/Row"]
custom_minimum_size = Vector2(90, 48)
placeholder_text = "Rating (100–3500)"

[node name="SiteLabel" type="Label" parent="Content/Row"]
text = "in rapid on"
vertical_alignment = 1

[node name="RatingSite" type="OptionButton" parent="Content/Row"]
custom_minimum_size = Vector2(120, 48)

[node name="ScaleHint" type="Label" parent="Content"]
theme_type_variation = &"MutedText"

[node name="Error" type="Label" parent="Content"]
visible = false
text = "Could not save your rating. Please try again."
