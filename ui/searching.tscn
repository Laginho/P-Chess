[ext_resource type="Texture2D" path="res://ui/icons/blitz.svg" id="4"]

[sub_resource type="StyleBoxFlat" id="AvatarStyle"]
bg_color = Color(0.498, 0.651, 0.314, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
