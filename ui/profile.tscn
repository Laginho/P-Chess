[gd_scene format=3]

[ext_resource type="Script" path="res://ui/profile.gd" id="1"]
[ext_resource type="Script" path="res://ui/accuracy_chart.gd" id="2"]

[node name="Profile" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.09, 0.11, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 12

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Profile"

[node name="NameRow" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="NameLabel" type="Label" parent="Margin/Content/NameRow"]
layout_mode = 2
text = "Your name"

[node name="PlayerName" type="LineEdit" parent="Margin/Content/NameRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Your name"

[node name="SaveName" type="Button" parent="Margin/Content/NameRow"]
layout_mode = 2
text = "Save name"

[node name="NameError" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 2
text = "Please enter a name."

[node name="GamesValue" type="Label" parent="Margin/Content"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="ResultsTitle" type="Label" parent="Margin/Content/Scroll/Body"]
layout_mode = 2
text = "Results by level and time control"

[node name="Results" type="GridContainer" parent="Margin/Content/Scroll/Body"]
layout_mode = 2
columns = 7
theme_override_constants/h_separation = 16

[node name="NoResults" type="Label" parent="Margin/Content/Scroll/Body"]
layout_mode = 2
text = "No games played yet."

[node name="AccuracyTitle" type="Label" parent="Margin/Content/Scroll/Body"]
layout_mode = 2
text = "Your accuracy over time"

[node name="AccuracyChart" type="Control" parent="Margin/Content/Scroll/Body"]
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
script = ExtResource("2")

[node name="NoAccuracy" type="Label" parent="Margin/Content/Scroll/Body"]
layout_mode = 2
text = "No analysed games with moves by you yet."

[node name="Back" type="Button" parent="Margin/Content"]
layout_mode = 2
text = "Back"
